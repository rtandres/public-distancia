%gas ideal y mezclas
%disoluciones
%estequiometría: ajuste, reactivo limitante, reactivos en disolución e impuros


\begin{enumerate}
  \setlength\itemsep{1.5em}
  
   \item 	 Dos planetas, $A$ y $B$, tienen el mismo radio. La aceleración gravitatoria en la 
				superficie del planeta $A$ es tres veces superior a la aceleración gravitatoria en 					la superficie del  planeta B. Calcule: 
					\begin{itemize}
						\item[a)]  La relación entre las densidades de los dos planetas.
						\item[b)] La velocidad de escape desde la superficie del planeta $B$ si se 								sabe que la velocidad de escape desde la superficie del planeta $A$ es de $2\;km\,s^{-1}$.
					\end{itemize}
	\qed
	
	
	\item 	La masa del Sol es 333183 veces mayor que la de la Tierra y la distancia que
separa sus centros es de $1.5\cdot 10^8$ km. Determine si existe algún punto a lo largo de la línea que los une en el que se anule:
				\begin{itemize}
					\item[a)] El potencial gravitatorio. Si se anula: calcule su distancia a 									la Tierra.
					\item[b)] El campo gravitatorio. Si se anula: calcule su distancia a la 									Tierra.
				\end{itemize}
							\textit{\small \textbf{Dato:} $G\simeq 6.67\cdot 10^{-11}$ N·m$^2$·kg$^{-2}$}

				\qed
		
   
		\item   El radio de uno de los asteroides, de forma esférica, perteneciente a los anillos de
Saturno es de $5\;km$. Suponiendo que la densidad de dicho asteroide es uniforme y de valor $5.5$ g
cm$^{-3}$. Calcule:
			\begin{itemize}
				\item[a)] La aceleración de la gravedad en su superficie.
				\item[b)] La velocidad de escape desde la superficie del asteroide.
			\end{itemize}
			\textit{\small \textbf{Dato:} $G\simeq 6.67\cdot 10^{-11}$ N·m$^2$·kg$^{-2}$}
			\qed
			
			
\begin{minipage}{11.5cm}
		\item  Se disponen  ---según se indica en la figura--- tres cargas eléctricas puntuales en los vértices de un triángulo rectángulo cuyos catetos tienen una longitud $L$.
			\begin{itemize}
				\item[a)] Calcule la fuerza total, $F$, ejercida por las cargas $q_1$ y $q_2$ sobre la carga $q_3$ , y dibuje el diagrama de fuerzas de la carga $q_3$.
				\item[b)] ¿Cuál sería el trabajo necesario para llevar la carga $q_3$ desde su
posición actual al punto $P(1.2;1.2)$ m?
			\end{itemize}
			\textit{\small \textbf{Datos numéricos}:
			\newline  $K\simeq 9\cdot 10^9\;Nm^2C^{-2},\hspace{1cm}L=1.2\;m,\newline$
			$ q_1=q_2=5\;nC,\hspace{1cm} q_3=-5\;nC.$}
			
		\end{minipage}\hfill
		\begin{minipage}{5.5cm}
			\includegraphics[scale=.6]{es.png}
		\end{minipage}
		\qed
	
    
\end{enumerate}

\end{document}

