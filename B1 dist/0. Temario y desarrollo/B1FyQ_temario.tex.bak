%cajas
\usepackage[skins]{tcolorbox}

\newtcolorbox{tagbox}[1][]{
  colback=blue!10!white,
  arc=0pt,
  auto outer arc,
%  sharp corners,
  boxrule=0pt,
  enhanced jigsaw,
  nobeforeafter,
  width=0.58\textwidth,
  boxsep=0pt,
 % halign=,
  valign=center,
  box align=center,
  colupper={blue!20!black}, % a dark blue
  fontupper={\bfseries},
  top=\fboxsep,
  bottom=\fboxsep,
  left=\fboxsep,
  right=\fboxsep,
  baseline=\fboxsep,
  #1
}

\newtcolorbox{tagboxtwo}[1][]{
  colback=blue!10!white,
  arc=0pt,
  auto outer arc,
%  sharp corners,
  boxrule=0pt,
  enhanced jigsaw,
  nobeforeafter,
  width=.9\textwidth,
  boxsep=0pt,
 % halign=,
  valign=center,
  box align=center,
  colupper={blue!20!black}, % a dark blue
  fontupper={},
  top=\fboxsep,
  bottom=\fboxsep,
  left=\fboxsep,
  right=\fboxsep,
  baseline=\fboxsep,
  #1
}

\newtcolorbox{tagboxtres}[1][]{
  colback=blue!10!white,
  arc=0pt,
  auto outer arc,
%  sharp corners,
  boxrule=0pt,
  enhanced jigsaw,
  nobeforeafter,
  width=.5\textwidth,
  boxsep=0pt,
 % halign=,
  valign=center,
  box align=center,
  colupper={blue!20!black}, % a dark blue
  fontupper={\centering},
  top=\fboxsep,
  bottom=\fboxsep,
  left=\fboxsep,
  right=\fboxsep,
  baseline=\fboxsep,
  #1
}

\newcommand{\sotagbox}[2][]{%
  \begin{tagbox}[#1]%
    #2
  \end{tagbox}%
}

\newcommand{\sotagboxtwo}[2][]{%
  \begin{tagboxtwo}[#1]%
    #2
  \end{tagboxtwo}%
}

\newcommand{\sotagboxtres}[2][]{%
  \begin{tagboxtres}[#1]%
    #2
  \end{tagboxtres}%
}

